#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 OR MIT
#
# Fails when any restatement of the crate version disagrees with
# Cargo.toml: both lockfiles, CITATION.cff, the SECURITY.md and SUPPORT.md
# support tables, the README install snippet, the bug report form and the
# KEYS.asc example. The User-Agent and VERSION constant are built from
# Cargo.toml, so they cannot drift. With --tag vX.Y.Z it also checks the
# tag names that version, and once CHANGELOG.md dates the version, that
# releases/v<version>.md (the release highlights) exists.
#
#   scripts/verify-release-versions
#   scripts/verify-release-versions --tag v0.0.88
set -euo pipefail

cd "$(dirname "$0")/.."

version="$(sed -n 's/^version = "\([^"]*\)"$/\1/p' Cargo.toml | head -n 1)"
if [ -z "$version" ]; then
  echo "verify-release-versions: no version in Cargo.toml" >&2
  exit 1
fi
failures=0

# expect FILE TEXT: FILE must contain TEXT, verbatim.
expect() {
  if ! grep -qF -- "$2" "$1"; then
    echo "verify-release-versions: $1 lacks: $2" >&2
    failures=$((failures + 1))
  fi
}

# locked FILE: the pain001-sdk entry of a lockfile has the version.
locked() {
  if ! grep -A1 -x 'name = "pain001-sdk"' "$1" | grep -qx "version = \"$version\""; then
    echo "verify-release-versions: $1 does not lock pain001-sdk $version" >&2
    failures=$((failures + 1))
  fi
}

locked Cargo.lock
locked fuzz/Cargo.lock
expect CITATION.cff "version: \"$version\""
expect SECURITY.md "| \`$version\` | Current"
expect SUPPORT.md "| \`$version\` | Current"
expect README.md "pain001-sdk = \"$version\""
expect .github/ISSUE_TEMPLATE/bug_report.yml "placeholder: \"$version\""
expect KEYS.asc "git verify-tag v$version"

if [ "${1:-}" = "--tag" ]; then
  tag="${2:?--tag needs a value}"
  if [ "$tag" != "v$version" ]; then
    echo "verify-release-versions: tag $tag, but Cargo.toml says $version" >&2
    failures=$((failures + 1))
  fi
fi

if grep -qE "^## \[$version\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" CHANGELOG.md; then
  if [ ! -f "releases/v$version.md" ]; then
    echo "verify-release-versions: CHANGELOG dates $version; releases/v$version.md is missing" >&2
    failures=$((failures + 1))
  fi
elif ! grep -qx '## \[Unreleased\]' CHANGELOG.md; then
  echo "verify-release-versions: CHANGELOG.md has neither [Unreleased] nor a dated [$version]" >&2
  failures=$((failures + 1))
fi

if [ "$failures" -ne 0 ]; then
  echo "verify-release-versions: $failures mismatch(es) with $version" >&2
  exit 1
fi
echo "verify-release-versions: every restatement says $version"
